# Copy to .env (or run ./gen-env.sh, which fills it with random test values). Never commit .env.
# Test values only, generated on the fly: never real credentials.
POSTGRES_ADMIN_PASSWORD=
CORE_DB_PASSWORD=
SCHEDULE_DB_PASSWORD=
MONGO_ROOT_PASSWORD=
SCHEDULE_MONGO_PASSWORD=
# UUID of the fixed user (created_by) while auth is not part of the exercise.
FIXED_USER_ID=

# Optional
# Capture windows, America/Bogota. Widen them to test a capture right now, e.g. 00:00-23:59.
# SCHEDULE_SCRAPE_WINDOWS=04:00-06:00,18:00-20:00
# Folder that holds the sibling repos (core-service, schedule-service, scraper-service, foundit-web-app).
# IFI_REPOS_DIR=../../..
